# ========== REQUIRED ==========

# MongoDB (local or Atlas M0 free cluster)
MONGODB_URI=mongodb://localhost:27017/corporate-ai

# Auth — CHANGE THESE (use random 32+ char strings)
JWT_SECRET=change-this-to-a-random-32-char-string
JWT_REFRESH_SECRET=change-this-to-another-random-string
JWT_EXPIRES_IN=24h

# Server
PORT=4000
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# ========== AI (Free) ==========

# Get free key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# ========== OPTIONAL ==========

# Email (Gmail with App Password)
# How to get app password: https://myaccount.google.com/apppasswords
GMAIL_USER=your-gmail@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Redis (enables BullMQ job queues — Upstash free: 10K commands/day)
REDIS_URL=

# Google Calendar OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback

# Slack Bot
SLACK_BOT_TOKEN=

# Firebase Push Notifications
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# Cloudflare R2 File Storage (10GB free)
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=
R2_ENDPOINT=
